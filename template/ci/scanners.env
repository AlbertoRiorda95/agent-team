# ci/scanners.env: versions and policies of the CI security steps.
# CUSTOMIZE: bump the versions on purpose (read the release notes), tune the policies.
SYFT_VERSION=1.54.1
GRYPE_VERSION=0.120.1
TRIVY_VERSION=0.76.0
SEMGREP_VERSION=1.180.0
ACTIONLINT_VERSION=1.7.12
# reference documentation generators (ci/reference.sh)
REDOCLY_VERSION=2.72.1
TYPEDOC_VERSION=0.28.20
PDOC_VERSION=16.0.0
# Python package to document; empty: the first one under src/
PYTHON_PACKAGE=

# grype: fail on vulnerabilities of this severity or worse (negligible, low, medium, high, critical)
VULN_FAIL_ON=high
# trivy: severities that fail the build for secrets and misconfigurations
TRIVY_FAIL_SEVERITY=HIGH,CRITICAL
# trivy license categories: CRITICAL = forbidden, HIGH = restricted, MEDIUM = reciprocal
LICENSE_FAIL_SEVERITY=CRITICAL
# directories trivy skips for secrets and misconfigurations (dependencies, build output)
TRIVY_SKIP_DIRS=node_modules,dist,build,reports

# semgrep (static analysis): rulesets separated by spaces. p/ci are rules meant
# to block a merge, with few false positives. Add the packs of your stack
# (p/typescript, p/python, p/golang, p/java, p/c...) or local rule files.
SEMGREP_CONFIG="p/ci"
# severities that fail a PR/MR when the change introduces them
# (ERROR, WARNING, INFO; recent rules may also use CRITICAL, HIGH, MEDIUM, LOW)
STATIC_FAIL_SEVERITY=ERROR,CRITICAL,HIGH
# full scan of the default branch: fail too (yes) or report only (no)
STATIC_FAIL_FULL=no
# paths semgrep skips
SEMGREP_EXCLUDE=node_modules,dist,build,reports

REPORTS_DIR=reports
