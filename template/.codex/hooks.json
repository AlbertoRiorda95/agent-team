{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"$(git rev-parse --show-toplevel)/scripts/hooks/block-infra-commands.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"$(git rev-parse --show-toplevel)/scripts/hooks/handoff-pointer.sh\""
          }
        ]
      }
    ]
  }
}
